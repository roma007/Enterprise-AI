# Docker Compose 环境变量
# 本地演示：SEED_DEMO=true，AUTH_REQUIRED=false
# 生产：SEED_DEMO=false，AUTH_REQUIRED=true，并替换所有密码/密钥

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_delivery

AUTH_SECRET=change-me-to-a-long-random-string
AUTH_REQUIRED=false
SEED_DEMO=true

# 发布版本：镜像 tag / git sha，会出现在 /api/health 与 x-app-version 响应头
APP_VERSION=0.1.0

# 支付：manual（默认，平台确认收款）/ mock（仅本地测试）/ callback（网关回调）
PAYMENT_PROVIDER=manual
BILLING_WEBHOOK_SECRET=change-me-billing-webhook

# 备份/演练心跳（可选）
BACKUP_DIR=./backups
# node_exporter textfile collector 目录；设置后 backup.sh / restore-drill.sh 会写入 .prom
# PROM_TEXTFILE_DIR=/var/lib/node_exporter/textfile

# ============ 登录（A1） ============
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=
# 不设则自动生成并只在控制台打印一次
AUTH_SECRET=
AUTH_TOKEN_TTL=43200
