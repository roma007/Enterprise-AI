# Docker Compose 环境变量
# 本地演示：SEED_DEMO=true，AUTH_REQUIRED=false
# 生产：SEED_DEMO=false，AUTH_REQUIRED=true，并替换所有密码/密钥

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_delivery

AUTH_SECRET=change-me-to-a-long-random-string
AUTH_REQUIRED=false
SEED_DEMO=true

# ============ 登录（A1） ============
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=
# 不设则自动生成并只在控制台打印一次
AUTH_SECRET=
AUTH_TOKEN_TTL=43200
