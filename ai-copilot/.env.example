# ============ 模型网关 ============
# 任何 OpenAI 兼容接口均可。留空 LLM_API_KEY 则自动回退到 rule-based-v1。

# --- 选项 A：OpenCode Go 推理网关（本项目当前使用） ---
# 1) 该网关校验 User-Agent，且必须带会话头，否则返回 403 / 400
# 2) 模型名不带 provider 前缀，例如 claude-haiku-5-5
# LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LLM_MODEL=claude-haiku-5-5
# LLM_USER_AGENT=ai-copilot/1.0
# LLM_SESSION_HEADER=x-opencode-session

# --- 选项 B：DeepSeek / 通义 / 智谱 / 本地 vLLM ---
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2000

# ============ 何时调用模型 ============
# auto  ：规则已覆盖必填且置信度足够时跳过模型（快、省；实测牺牲约 1pp）
# always：每条都调模型（慢 10 倍，用于做全量对照）
# off   ：合并模式下不调模型
LLM_STRATEGY=auto
LLM_BELOW_CONF=0.6

# ============ 合并策略 ============
# fill_only：规则先跑，模型只补空字段（28 份样本实验最优，见 README §四）
# floor    ：规则置信度 ≥ MERGE_RULE_FLOOR 时规则优先，否则模型覆盖
# llm_wins ：模型优先（强格式字段仍以规则为准）
MERGE_POLICY=fill_only
MERGE_RULE_FLOOR=0.85

# ============ 数据 ============
# 遥测库（记录每次解析与人工修正，用于评测与成本核算）
DB_PATH=data/copilot.db

# ============ 公司信息（演示页脚） ============
ORG_NAME=

# ============ 企业微信入口（D3） ============
# 留空则跳过签名校验，仅用于本地调试；上线必须填
# 企业微信后台 → 应用 → 接收消息 → 服务器配置 里的 Token
WECOM_TOKEN=
# 企业号 CorpID（安全模式下作为 receiveid 校验，必填）
WECOM_CORPID=
# 安全模式必填：企业微信后台「接收消息 → 随机获取」的 EncodingAESKey（43 位）
# 留空 = 明文模式，仅用于本地调试；上线必须配
WECOM_ENCODING_AES_KEY=

# ============ 价值口径 ============
# 人工单票基线秒数（用于计算节省工时）
BASELINE_MANUAL_SEC=180
# 人工小时成本（元）
HOURLY_COST=45

# ============ 原件存储（A4 / A6） ============
# local：落本地目录（默认，单机够用）
# s3   ：AWS S3 / MinIO / 阿里云 OSS / 腾讯云 COS 等 S3 兼容存储
STORAGE_BACKEND=local
STORAGE_DIR=data/uploads

# 仅 STORAGE_BACKEND=s3 时需要（先 pip install boto3）
S3_BUCKET=
S3_PREFIX=uploads/
# MinIO / OSS / COS 的 S3 兼容端点；用 AWS 时留空
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
