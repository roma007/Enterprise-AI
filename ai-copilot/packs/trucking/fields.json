        "kind": "text",
        "normalize": "amount"
      },
      {
        "key": "item_summary",
        "label": "货物或服务",
        "hint": "品名摘要",
        "example": "0# 柴油",
        "blocking": false,
        "kind": "text",
        "normalize": "text_name"
      },
      {
        "key": "check_code",
        "label": "校验码",
        "hint": "专票 20 位",
        "example": "",
        "blocking": false,
        "kind": "text",
        "normalize": "text"
      },
      {
        "key": "remark",
        "label": "备注",
        "hint": "",
        "example": "",
        "blocking": false,
        "kind": "text",
        "normalize": "text_name"
      }
    ]
  }
