{
  "booking": {
    "label": "托书",
    "fields": [
      {
        "key": "client",
        "label": "客户/货代",
        "hint": "委托方公司名称",
        "example": "宏远国际货代",
        "blocking": true,
        "kind": "text",
        "normalize": "text_name"
      },
      {
        "key": "booking_no",
        "label": "委托单号",
        "hint": "托书/委托单编号",
        "example": "HY2026110501",
        "blocking": true,
        "kind": "text",
        "normalize": "text"
      },
      {
        "key": "bl_no",
        "label": "提单号",
        "hint": "B/L No.",
        "example": "COSU6398471120",
        "blocking": false,
        "kind": "text",
        "normalize": "text"
      },
      {
        "key": "so_no",
        "label": "SO号",
        "hint": "Shipping Order 号",
        "example": "SO-778123",
        "blocking": false,
        "kind": "text",
        "normalize": "so_no"
      },
      {
        "key": "container_type",
        "label": "箱型",
        "hint": "如 20GP / 40HQ / 40RF",
        "example": "40HQ",
        "blocking": true,
        "kind": "text",
        "normalize": "container_type"
      },
      {
        "key": "container_qty",
        "label": "箱量",
        "hint": "整数",
        "example": "2",
        "blocking": false,
        "kind": "number",
        "normalize": "quantity"
      },
      {
        "key": "container_no",
        "label": "箱号",
        "hint": "ISO 6346，多个用逗号分隔",
        "example": "CSQU3054383",
        "blocking": false,
        "kind": "text",
        "normalize": "container_list"
      },
      {
        "key": "seal_no",
        "label": "封号",
        "hint": "铅封号，多个用逗号分隔",
        "example": "SL8823101",
        "blocking": false,
        "kind": "text",
        "normalize": "container_list"
      },
      {
        "key": "pickup_addr",
        "label": "提箱/装货地",
        "hint": "提空箱堆场或工厂装货地址",
        "example": "北仑港区二期堆场",
        "blocking": true,
        "kind": "text",
        "normalize": "text_name"
      },
      {
        "key": "delivery_addr",
        "label": "卸货/送货地",
        "hint": "重箱送达地址",
        "example": "宁波北仑春晓工业园 3 号仓",
        "blocking": true,
        "kind": "text",
        "normalize": "text_name"
      },
      {
        "key": "factory_contact",
        "label": "工厂联系人",
        "hint": "姓名",
        "example": "王主管",
        "blocking": false,
        "kind": "text",
        "normalize": "text"
      },
      {
        "key": "factory_phone",
        "label": "联系电话",
        "hint": "手机或固话",
        "example": "13800001234",
        "blocking": false,
        "kind": "text",
        "normalize": "number"
      },
      {
        "key": "loading_window",
        "label": "装柜时间窗",
        "hint": "可装柜的时间范围",
        "example": "2026-11-06 08:00~12:00",
        "blocking": false,
        "kind": "datetime",
        "normalize": "datetime"
      },
      {
        "key": "closing_time",
        "label": "截港时间",
        "hint": "码头截关/截港时间",
        "example": "2026-11-07 18:00",
        "blocking": false,
        "kind": "datetime",
        "normalize": "datetime"
      },
      {
        "key": "vessel_voyage",
        "label": "船名航次",
        "hint": "Vessel / Voyage",
        "example": "COSCO SHIPPING ARIES / 042E",
        "blocking": false,
        "kind": "text",
        "normalize": "text_name"
      },
      {
        "key": "depot",
        "label": "提空箱点",
        "hint": "堆场名称",
        "example": "北仑三期堆场",
        "blocking": false,
        "kind": "text",
        "normalize": "text"
      },
      {
        "key": "cargo_desc",
        "label": "品名",
        "hint": "货物描述",
        "example": "家用电器",
        "blocking": false,
        "kind": "text",
        "normalize": "text_name"
      },
      {
        "key": "gross_weight",
        "label": "毛重",
        "hint": "KGS",
        "example": "18600",
        "blocking": false,
        "kind": "text",
        "normalize": "number"
      },
      {
        "key": "freight",
        "label": "运费",
        "hint": "报价或金额",
        "example": "2600",
        "blocking": false,
        "kind": "text",
        "normalize": "amount"
      },
      {
        "key": "remark",
        "label": "备注",
        "hint": "其他要求，如报关、押车、加急",
        "example": "需报关，周五前必须进港",
        "blocking": false,
        "kind": "text",
        "normalize": "text_name"
      }
    ]
  },
  "invoice": {
    "label": "发票",
    "fields": [
      {
        "key": "invoice_code",
        "label": "发票代码",
        "hint": "10-12 位数字，全电发票可能没有",
        "example": "033002100311",
        "blocking": false,
        "kind": "text",
        "normalize": "text"
      },
      {
        "key": "invoice_no",
        "label": "发票号码",
        "hint": "8 位或 20 位数字",
        "example": "12345678",
        "blocking": true,
        "kind": "text",
        "normalize": "text"
      },
      {
        "key": "invoice_date",
        "label": "开票日期",
        "hint": "YYYY-MM-DD",
        "example": "2026-10-28",
        "blocking": false,
        "kind": "text",
        "normalize": "datetime"
      },
      {
        "key": "invoice_type",
        "label": "发票类型",
        "hint": "专票/普票/电子普票/全电发票",
