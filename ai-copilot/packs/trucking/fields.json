        "blocking": false,
        "kind": "text",
        "normalize": "text_name"
      },
      {
        "key": "buyer_tax_id",
        "label": "购买方税号",
        "hint": "18 位统一社会信用代码",
        "example": "9133020662M3QQRL4D",
        "blocking": true,
        "kind": "text",
        "normalize": "text"
      },
      {
        "key": "seller_name",
        "label": "销售方名称",
        "hint": "开票方公司全称",
        "example": "宁波北仑中石化加油站",
        "blocking": false,
        "kind": "text",
        "normalize": "text_name"
      },
      {
        "key": "seller_tax_id",
        "label": "销售方税号",
        "hint": "18 位统一社会信用代码",
        "example": "91330200TF3NLDC9HT",
        "blocking": false,
        "kind": "text",
        "normalize": "text"
      },
      {
        "key": "amount",
        "label": "金额（不含税）",
        "hint": "不含税金额",
        "example": "1234.56",
        "blocking": true,
        "kind": "text",
        "normalize": "amount"
      },
      {
        "key": "tax_rate",
        "label": "税率",
        "hint": "0.13 / 0.09 / 0.06 / 0.03 / 0.01",
