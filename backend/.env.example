DATABASE_URL=postgres://127.0.0.1:5432/ai_delivery
PORT=8788
HOST=127.0.0.1
LOG_LEVEL=info

# 登录 token 的 HMAC 密钥；生产必须替换
AUTH_SECRET=dev-only-change-me
# false：本地开发允许匿名；生产设为 true
AUTH_REQUIRED=false

# 可选大模型（OpenAI 兼容 /chat/completions）
# 不配置时 AI 助手自动使用 rule-based-v1，不发起外部请求
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=25000

# 慢请求日志阈值（毫秒）
SLOW_REQUEST_MS=500

# 可选：/metrics 访问令牌；设置后需 Bearer 或 ?token=
# METRICS_TOKEN=

# 审计日志热表保留天数（CLI 默认值，按 cron 执行）
AUDIT_RETENTION_DAYS=180

# 可选：指定无头 Chromium 路径（PDF 导出）；不设则自动查找系统/Playwright 浏览器
# PDF_CHROME_PATH=/usr/bin/chromium

# PDF 缓存目录与保留天数（默认 backend/.pdf-cache，30 天）
# PDF_CACHE_DIR=
PDF_CACHE_TTL_DAYS=30

# PDF 任务记录保留天数（CLI 默认值）
PDF_JOB_RETENTION_DAYS=30

# 客户分享限流（每 IP + token）与反向代理 IP 信任
PUBLIC_SHARE_RATE_LIMIT=60
PUBLIC_SHARE_RATE_WINDOW_MS=60000
# TRUST_PROXY=true

# 分享访问明细保留天数（CLI 默认值）
SHARE_VIEW_RETENTION_DAYS=180

# 登录失败限流（每 IP + 邮箱）
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MS=900000

# 登录会话记录保留天数（CLI 默认值，只清理已过期/已撤销）
USER_SESSION_RETENTION_DAYS=30

# ai-copilot 回写令牌（B4）；不配置则 POST /api/hooks/copilot/* 返回 503
# 与客户侧 ai-copilot 的 DELIVERY_HOOK_TOKEN 保持一致
COPILOT_HOOK_TOKEN=

# RLS 受限应用角色（迁移 0029 创建）；设为 off 可临时退回应用层隔离
DB_APP_ROLE=ai_delivery_app

# 数据库连接池上限（请求级连接复用）
PG_POOL_MAX=20

# PDF worker：生产建议 API 设 false，独立启动 worker:pdf
# PDF_WORKER_INLINE=false
PDF_JOB_LEASE_MINUTES=15

# 对象存储：local / s3（留空 local）
STORAGE_DRIVER=local
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=ai-delivery
# S3_PREFIX=ai-delivery
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Redis：登录限流与会话缓存；不配置则回退进程内存
# REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=ai-delivery:

# 支付：mock / manual / callback
# mock：租户可在本地模拟支付；manual：平台管理员确认收款；callback：网关回调
PAYMENT_PROVIDER=mock
# callback 模式下用于校验 x-billing-signature = HMAC-SHA256(invoice_id:status:external_id)
BILLING_WEBHOOK_SECRET=

# 对账批量任务：running 超过该分钟数会被标记为失败（默认 10）
# BATCH_RUNNING_TIMEOUT_MINUTES=10

# 常驻批量回收任务间隔（秒），默认 300；0 表示关闭
# BATCH_REAP_INTERVAL_SECONDS=300

# 审计导出任务与文件保留天数（默认 7）与清理间隔（秒，默认 3600，0 关闭）
# AUDIT_EXPORT_RETENTION_DAYS=7
# AUDIT_EXPORT_CLEANUP_INTERVAL_SECONDS=3600
# AUDIT_EXPORT_MAX_ROWS=100000

# 通知回收站保留天数（默认 30）与自动清理间隔（秒，默认 3600，0 关闭）
# NOTIFICATION_TRASH_RETENTION_DAYS=30
# NOTIFICATION_CLEANUP_INTERVAL_SECONDS=3600

# 协作审计保留天数（默认 365）与自动归档间隔（秒，默认 86400，0 关闭）
# COLLAB_AUDIT_RETENTION_DAYS=365
# COLLAB_AUDIT_ARCHIVE_INTERVAL_SECONDS=86400

# 协作审计快照间隔（秒，默认 86400，0 关闭）
# COLLAB_AUDIT_SNAPSHOT_INTERVAL_SECONDS=86400

# 协作审计快照保留天数（默认 365）
# COLLAB_AUDIT_SNAPSHOT_RETENTION_DAYS=365
