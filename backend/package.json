{
  "name": "ai-delivery-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "企业 AI 化项目管理系统 · 后端（诊断阶段 MVP）",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "tsx scripts/demo.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "psql \"${DATABASE_URL:-postgres://127.0.0.1:5432/ai_delivery}\" -v ON_ERROR_STOP=1 -q -f db/003_seed.sql",
    "db:reset": "psql \"${DATABASE_URL:-postgres://127.0.0.1:5432/ai_delivery}\" -v ON_ERROR_STOP=1 -q -f db/000_reset.sql && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-rules.ts",
    "verify:report": "tsx scripts/verify-report.ts",
    "verify:write": "tsx scripts/verify-write.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "audit:archive": "tsx scripts/archive-audit.ts",
    "pdf:cleanup": "tsx scripts/cleanup-pdf-jobs.ts",
    "share:cleanup": "tsx scripts/cleanup-share-views.ts",
    "share:archive": "tsx scripts/cleanup-share-views.ts",
    "sessions:cleanup": "tsx scripts/cleanup-user-sessions.ts",
    "worker:pdf": "tsx scripts/pdf-worker.ts",
    "smoke:replicas": "tsx scripts/multi-replica-smoke.ts",
    "soak:replicas": "tsx scripts/multi-replica-soak.ts",
    "drill:rollout": "tsx scripts/rolling-release-drill.ts",
    "drill:alerts": "tsx scripts/alert-route-drill.ts",
    "drill:s3": "tsx scripts/s3-drill.ts",
    "billing:run": "tsx scripts/billing-run.ts",
    "batches:reap": "tsx scripts/reap-batches.ts",
    "notifications:cleanup": "tsx scripts/cleanup-notifications.ts",
    "collab-audits:archive": "tsx scripts/archive-collab-audits.ts",
    "collab-audits:snapshot": "tsx scripts/snapshot-collab-audits.ts",
    "collab-audits:digest": "tsx scripts/collab-audit-digest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/request-context": "^7.0.5",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "docx": "^9.15.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "marked": "^18.1.2",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "s3rver": "^3.7.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "yaml": "^2.9.1"
  }
}
