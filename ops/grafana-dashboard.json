      "targets": [
        { "expr": "sum(rate(slow_requests_total{job=\"ai-delivery-backend\"}[5m]))", "legendFormat": "slow/s", "refId": "A" },
        { "expr": "sum(increase(slow_requests_total{job=\"ai-delivery-backend\"}[1h]))", "legendFormat": "slow/1h", "refId": "B" }
      ],
      "title": "慢请求",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
