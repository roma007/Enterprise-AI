        { "expr": "sum by (status) (rate(http_requests_total{job=\"ai-delivery-backend\",status=~\"4..\"}[5m]))", "legendFormat": "{{status}}", "refId": "B" },
        { "expr": "sum by (status) (rate(http_requests_total{job=\"ai-delivery-backend\",status=~\"5..\"}[5m]))", "legendFormat": "{{status}}", "refId": "C" }
      ],
      "title": "请求速率（按状态码）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
